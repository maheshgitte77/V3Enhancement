# Shared Kafka Configuration
KAFKA_BROKER=kafka1:9092,kafka2:9093,kafka3:9094

# Shared API Keys
GEMINI_API_KEY=your_gemini_api_key_here
OPEN_AI_KEY=your_openai_key_here

# Shared Database Configuration
DB_USERNAME=your_db_username
DB_PASSWORD=your_db_password
DB_NAME=your_db_name
DB_HOST=your_db_host
DB_PORT=27017

# Shared Redis Configuration
REDIS_PASSWORD=your_redis_password
REDIS_HOST=your_redis_host
REDIS_PORT=19322

# Shared Notification Service
NOTIFICATION_SERVICE_URL=you_notification_service_url

# Shared S3 Configuration
S3_BUCKET_NAME=your_s3_bucket_name
S3_REGION=ap-south-1
S3_ACCESS_KEY_ID=your_s3_access_key_id
S3_SECRET_ACCESS_KEY=your_s3_secret_access_key

# Shared Consumer Configuration
NUM_CONSUMERS=6
