# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.js

# testing
/coverage

# production
/build

# misc
.DS_Store
tasks.json
extensions.json

# Environment files with secrets (keep these ignored)
.env
.env.local
docker/.env
docker/.env.production.local


# Service-specific secret files (if any exist)
gcp-key.json
workers/gcp-key.json
.gcp-key.json

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Package lock files (optional - uncomment if you don't want to commit these)
# yarn.lock
# package-lock.json
